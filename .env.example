# Copy this file to ".env" and fill in your own values.
# The .env file stays on your computer. Git ignores it.

# ---- eBay ----
# "sandbox" for practice listings, "production" for real listings.
EBAY_ENV=sandbox
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
# eBay calls this the "RuName". You find it under User Tokens on the developer site.
EBAY_RUNAME=

# Production keys used only to look up prices.
# The sandbox has no real listings, so price lookups need production keys.
# Leave blank when EBAY_ENV=production; the program then reuses the keys above.
PRICING_APP_ID=
PRICING_CERT_ID=

# Seller policy IDs. Run "python -m cardlister policies" to list yours.
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
# A short name for your ship-from location. Run "python -m cardlister location" once.
EBAY_LOCATION_KEY=home

# ---- AI that reads each card ----
ANTHROPIC_API_KEY=

# ---- AI that edits each photo into a studio shot ----
# Leave blank to use the free basic editor on your computer instead.
PHOTOROOM_API_KEY=
# Studio background color as a hex code. FFFFFF is white.
STUDIO_BACKGROUND=FFFFFF

# ---- Auction settings ----
AUCTION_DAYS=3
START_PRICE=0.99

# ---- Store cash estimate ----
# Share of quick-sale value a card shop pays in cash. 0.50 means 50 percent.
STORE_CASH_RATE=0.50
# Cards worth less than this count as "bulk".
BULK_THRESHOLD=3.00
# Cash a shop pays per bulk card.
BULK_CASH_PER_CARD=0.05

# Text added to every listing description.
SHIPPING_NOTE=Ships in a penny sleeve and top loader.
